# Copy to backend/.env (gitignored) and fill with real values. Never commit the real .env file.
# This file is loaded automatically at startup (via the springboot3-dotenv dependency in pom.xml) — no need to `export`/`$env:` these
# manually. Real OS/container environment variables always take priority over this file, so production deployments are unaffected.

# ERPNext REST API base URL, e.g. http://localhost:8000 when running infra/ locally.
ERPNEXT_BASE_URL=http://localhost:8000

# Optional: the Frappe site name (e.g. "lab.localhost") when infra serves multiple sites behind one reverse-proxy port.
# Sent as the HTTP "Host" header on every request so ERPNext's nginx routes to the right site. Leave empty for a single-site setup.
ERPNEXT_SITE_HOST=

# ERPNext API Key/Secret pair, generated from a dedicated integration user (Settings > API Access).
# Sent as "Authorization: token <key>:<secret>"; never exposed to the frontend (Principle IV).
ERPNEXT_API_KEY=changeme-api-key
ERPNEXT_API_SECRET=changeme-api-secret

# ERPNext Company to use on every Purchase Order/Receipt (mandatory field on both DocTypes).
# The demo lab has exactly one Company (spec.md Assumptions), so it is never part of the frontend contract.
ERPNEXT_DEFAULT_COMPANY=changeme-company-name

# Port the Spring Boot backend listens on. Defaults to 8080 if unset; use a different port (e.g. 8081) if ERPNext's own
# reverse proxy already occupies 8080 on this machine.
BACKEND_PORT=8080
