# GTID replication source configuration for the primary MariaDB instance.
# server_id must be unique across primary and replica; log_bin is required
# to produce the binary log that the replica streams via GTID.
[mariadb]
server_id = 1
log_bin = mariadb-bin
log_bin_index = mariadb-bin.index
binlog_format = ROW
# gtid_domain_id groups transactions from this topology; both instances must
# share the same value so GTIDs generated here are recognized by the replica.
gtid_domain_id = 1
gtid_strict_mode = ON
expire_logs_days = 7
