# Copy this file to infra/.env and replace every fictitious value before
# running `docker compose up`. Never commit the resulting infra/.env file.

# --- ERPNext / Frappe image versions (registered in Fase 3, see README) ---
ERPNEXT_VERSION=v15.47.0
MARIADB_VERSION=10.6

# --- Frappe site created by the create-site service ---
SITE_NAME=lab.localhost
ADMIN_PASSWORD=changeme-admin-pw

# --- MariaDB root password, shared by primary and replica for this lab ---
MARIADB_ROOT_PASSWORD=changeme-root-pw

# --- Dedicated replication account (privilege: REPLICATION SLAVE only) ---
MARIADB_REPLICATION_USER=repl_user
MARIADB_REPLICATION_PASSWORD=changeme-repl-pw

# --- Host port published for the ERPNext web UI (frontend/nginx) ---
HTTP_PUBLISH_PORT=8080

# --- ERPNext integration user used later by backend/ (generated after the
# site is created with scripts/create-integration-user.sh); kept here only
# as a placeholder so backend/.env.example can reference the same names ---
ERPNEXT_INTEGRATION_API_KEY=changeme-api-key
ERPNEXT_INTEGRATION_API_SECRET=changeme-api-secret
